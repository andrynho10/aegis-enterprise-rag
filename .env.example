# ============================================================================
# AEGIS-RAG ENTERPRISE — CONFIGURACIÓN DE ENTORNO (.env)
# ============================================================================
APP_NAME="AegisRAG Enterprise - Plataforma Agentic RAG"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT="8080"

# --- 1. Identidad Corporativa (Active Directory / Microsoft Entra ID) ---
# Valores soportados: mock_ad | entra_id_msal | ad_ldap
IDP_MODE="mock_ad"
JWT_SECRET="enterprise-rag-super-secret-signing-key-2026-ley21719"
JWT_ISSUER="https://login.corporativo.cl/entra-id/v2.0"
JWT_AUDIENCE="api://enterprise-rag-assistant"

# Configuración Microsoft Entra ID (Azure AD) para producción con MSAL
ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"
ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"
ENTRA_CLIENT_SECRET=""

# Configuración Active Directory On-Premise para producción con ldap3
LDAP_SERVER_URI="ldaps://dc01.corporativo.local:636"
LDAP_BASE_DN="DC=corporativo,DC=local"

# --- 2. Base Vectorial & Embeddings Locales (Cero Exfiltración) ---
# Valores soportados: auto | chromadb | memory_hybrid
VECTOR_STORE_BACKEND="auto"
STRICT_COLLECTION_ISOLATION="true"
EMBEDDING_PROVIDER="local_hybrid"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# --- 3. Router Híbrido de LLMs ---
OLLAMA_CHAT_MODEL="llama3.1:8b"
VLLM_BASE_URL="http://127.0.0.1:8000/v1"
PRIVATE_CLOUD_PROVIDER="azure_openai_zdr"
PRIVATE_CLOUD_ENDPOINT="https://corp-openai-zdr.openai.azure.com/"
PRIVATE_CLOUD_API_KEY=""
EXTERNAL_API_ENDPOINT="https://api.openai.com/v1"
EXTERNAL_API_KEY=""

# --- 4. Privacidad y Cumplimiento Ley 21.719 ---
ENABLE_PII_ANONYMIZATION="true"
